diff --git a/recompui/shaders/InterfacePS.hlsl b/recompui/shaders/InterfacePS.hlsl
index 4d8a419..47a11e0 100644
--- a/recompui/shaders/InterfacePS.hlsl
+++ b/recompui/shaders/InterfacePS.hlsl
@@ -1,3 +1,15 @@
+// Rush 2049 patch: HDR output. The push constants InterfaceVS has, for hdrWhite: above 0, the colour (sRGB, an SDR
+// display's gamma 2.2) goes out in linear light with white at hdrWhite, for an scRGB swap chain.
+struct Input {
+    float4x4 transform;
+    float2 translation;
+    float hdrWhite;
+    float premultiplied;
+};
+
+[[vk::push_constant]]
+ConstantBuffer<Input> gInput : register(b0, space0);
+
 SamplerState gSampler : register(s1, space0);
 Texture2D<float4> gTexture : register(t2, space1);
 
@@ -8,4 +20,8 @@ void PSMain(
 )
 {
     oColor = gTexture.Sample(gSampler, iUV) * iColor;
+    if (gInput.hdrWhite > 0.0f) {
+        const float alpha = (gInput.premultiplied > 0.0f) ? max(oColor.a, 1.0f / 255.0f) : 1.0f;
+        oColor.rgb = pow(saturate(oColor.rgb / alpha), 2.2f) * gInput.hdrWhite * alpha;
+    }
 }
