diff --git a/src/hle/rt64_state.cpp b/src/hle/rt64_state.cpp
index 4502c4a..15ee711 100644
--- a/src/hle/rt64_state.cpp
+++ b/src/hle/rt64_state.cpp
@@ -55,6 +55,22 @@ namespace RT64 {
     float bloomThreshold() { return bloomThresholdValue.load(std::memory_order_relaxed); }
     float bloomRadius() { return bloomRadiusValue.load(std::memory_order_relaxed); }
 
+    static std::atomic<float> pictureBrightness{ 0.0f };
+    static std::atomic<float> pictureContrast{ 1.0f };
+    static std::atomic<float> pictureGamma{ 1.0f };
+
+    void setPictureAdjust(float brightness, float contrast, float gamma) {
+        pictureBrightness.store(brightness, std::memory_order_relaxed);
+        pictureContrast.store(contrast, std::memory_order_relaxed);
+        pictureGamma.store(gamma, std::memory_order_relaxed);
+    }
+
+    void pictureAdjust(float &brightness, float &contrast, float &gamma) {
+        brightness = pictureBrightness.load(std::memory_order_relaxed);
+        contrast = pictureContrast.load(std::memory_order_relaxed);
+        gamma = pictureGamma.load(std::memory_order_relaxed);
+    }
+
     // Rush 2049 patch: a game that draws see-through surfaces (blended, Z compare without Z update) in among the rest of
     // its scene leaves them to whatever is drawn after: on a console as here, a surface drawn later and farther away
     // passes the depth test where the see-through one is and paints over it, since the see-through one wrote no depth.
