diff --git a/src/shaders/VideoInterfacePS.hlsl b/src/shaders/VideoInterfacePS.hlsl
index 56c942d..ced3350 100644
--- a/src/shaders/VideoInterfacePS.hlsl
+++ b/src/shaders/VideoInterfacePS.hlsl
@@ -26,6 +26,16 @@ float4 SampleInput(float2 uv) {
     // Rush 2049 patch: the player's brightness, contrast and gamma.
     gammaCorrectedColor.rgb = pow(saturate(gammaCorrectedColor.rgb), gConstants.userGamma);
     gammaCorrectedColor.rgb = saturate((gammaCorrectedColor.rgb - 0.5f) * gConstants.contrast + 0.5f + gConstants.brightness);
+    // Rush 2049 patch: HDR output. The game's colours as an SDR display shows them (gamma 2.2) in linear light, its
+    // white at paper white, the parts brighter than most of the picture lifted smoothly towards the peak.
+    if (gConstants.hdrPaperWhite > 0.0f) {
+        float3 linearColor = pow(gammaCorrectedColor.rgb, 2.2f);
+        const float luminance = dot(linearColor, float3(0.2126f, 0.7152f, 0.0722f));
+        const float lift = saturate((luminance - 0.5f) / 0.5f);
+        const float ratio = gConstants.hdrPeak / gConstants.hdrPaperWhite;
+        linearColor *= gConstants.hdrPaperWhite * (1.0f + (ratio - 1.0f) * gConstants.hdrHighlights * lift * lift * lift);
+        gammaCorrectedColor.rgb = min(linearColor, gConstants.hdrPeak);
+    }
     gammaCorrectedColor.rgb *= max(1.0f - outsideBorder.x - outsideBorder.y, 0.0f);
     gammaCorrectedColor.a = 1.0f;
     return gammaCorrectedColor;
