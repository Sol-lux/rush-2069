diff --git a/src/hle/rt64_state.cpp b/src/hle/rt64_state.cpp
index 15ee711..351a5a6 100644
--- a/src/hle/rt64_state.cpp
+++ b/src/hle/rt64_state.cpp
@@ -71,6 +71,29 @@ namespace RT64 {
         gamma = pictureGamma.load(std::memory_order_relaxed);
     }
 
+    static std::atomic<bool> hdrRequested{ false };
+    static std::atomic<bool> hdrActive{ false };
+    static std::atomic<float> hdrPaperWhite{ 200.0f };
+    static std::atomic<float> hdrPeak{ 1000.0f };
+    static std::atomic<float> hdrHighlights{ 0.0f };
+
+    void setHdrOutput(bool enabled, float paperWhiteNits, float peakNits, float highlights) {
+        hdrRequested.store(enabled, std::memory_order_relaxed);
+        hdrPaperWhite.store(paperWhiteNits, std::memory_order_relaxed);
+        hdrPeak.store(peakNits, std::memory_order_relaxed);
+        hdrHighlights.store(highlights, std::memory_order_relaxed);
+    }
+
+    bool hdrOutputRequested() { return hdrRequested.load(std::memory_order_relaxed); }
+    void setHdrOutputActive(bool active) { hdrActive.store(active, std::memory_order_relaxed); }
+    bool hdrOutputActive() { return hdrActive.load(std::memory_order_relaxed); }
+
+    void hdrOutputLevels(float &paperWhiteNits, float &peakNits, float &highlights) {
+        paperWhiteNits = hdrPaperWhite.load(std::memory_order_relaxed);
+        peakNits = hdrPeak.load(std::memory_order_relaxed);
+        highlights = hdrHighlights.load(std::memory_order_relaxed);
+    }
+
     // Rush 2049 patch: a game that draws see-through surfaces (blended, Z compare without Z update) in among the rest of
     // its scene leaves them to whatever is drawn after: on a console as here, a surface drawn later and farther away
     // passes the depth test where the see-through one is and paints over it, since the see-through one wrote no depth.
