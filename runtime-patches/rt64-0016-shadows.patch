+                RenderInputElement("POSITION", 0, 0, RenderFormat::R32G32B32A32_FLOAT, 0, 0),
+                RenderInputElement("TEXCOORD", 0, 1, RenderFormat::R32G32B32A32_FLOAT, 1, 0)
+            };
+
+            layoutBuilder.begin(false, true);
+            layoutBuilder.addPushConstant(0, 0, sizeof(interop::ShadowCB), RenderShaderStageFlag::VERTEX | RenderShaderStageFlag::PIXEL);
+            layoutBuilder.end();
+            shadowDepth.pipelineLayout = layoutBuilder.create(device);
+
+            std::unique_ptr<RenderShader> depthVS = device->createShader(CREATE_SHADER_INPUTS(ShadowDepthVS, "VSMain", shaderFormat));
+            std::unique_ptr<RenderShader> depthPS = device->createShader(CREATE_SHADER_INPUTS(ShadowDepthPS, "PSMain", shaderFormat));
+            RenderGraphicsPipelineDesc depthDesc;
+            depthDesc.pipelineLayout = shadowDepth.pipelineLayout.get();
+            depthDesc.renderTargetCount = 0;
+            depthDesc.depthTargetFormat = ShadowMapFormat;
+            depthDesc.depthEnabled = true;
+            depthDesc.depthWriteEnabled = true;
+            depthDesc.depthFunction = RenderComparisonFunction::LESS;
+            depthDesc.depthClipEnabled = true;
+            depthDesc.slopeScaledDepthBias = 1.5f;
+            depthDesc.cullMode = RenderCullMode::NONE;
+            depthDesc.primitiveTopology = RenderPrimitiveTopology::TRIANGLE_LIST;
+            depthDesc.inputSlots = depthSlots;
+            depthDesc.inputSlotsCount = 1;
+            depthDesc.inputElements = depthElements;
+            depthDesc.inputElementsCount = 1;
+            depthDesc.vertexShader = depthVS.get();
+            depthDesc.pixelShader = depthPS.get();
+            shadowDepth.pipeline = device->createGraphicsPipeline(depthDesc);
+
+            BloomGlowDescriptorSet receiveSet; // gInput the shadow map, gScene the scene's depth
+            layoutBuilder.begin(false, true);
+            layoutBuilder.addPushConstant(0, 0, sizeof(interop::ShadowCB), RenderShaderStageFlag::VERTEX | RenderShaderStageFlag::PIXEL);
+            layoutBuilder.addDescriptorSet(receiveSet);
+            layoutBuilder.end();
+            shadowReceive.pipelineLayout = layoutBuilder.create(device);
+
+            std::unique_ptr<RenderShader> receiveVS = device->createShader(CREATE_SHADER_INPUTS(ShadowReceiveVS, "VSMain", shaderFormat));
+            std::unique_ptr<RenderShader> receivePS = (multisampling.sampleCount > 1) ?
+                device->createShader(CREATE_SHADER_INPUTS(ShadowReceivePSMS, "PSMain", shaderFormat)) :
+                device->createShader(CREATE_SHADER_INPUTS(ShadowReceivePS, "PSMain", shaderFormat));
+            RenderGraphicsPipelineDesc receiveDesc;
+            receiveDesc.pipelineLayout = shadowReceive.pipelineLayout.get();
+            receiveDesc.renderTargetBlend[0] = RenderBlendDesc::Copy();
+            receiveDesc.renderTargetBlend[0].blendEnabled = true;
+            receiveDesc.renderTargetBlend[0].srcBlend = RenderBlend::ZERO;
+            receiveDesc.renderTargetBlend[0].dstBlend = RenderBlend::SRC_COLOR;
+            receiveDesc.renderTargetBlend[0].blendOp = RenderBlendOperation::ADD;
+            receiveDesc.renderTargetBlend[0].srcBlendAlpha = RenderBlend::ZERO;
+            receiveDesc.renderTargetBlend[0].dstBlendAlpha = RenderBlend::ONE;
+            receiveDesc.renderTargetBlend[0].blendOpAlpha = RenderBlendOperation::ADD;
+            receiveDesc.renderTargetFormat[0] = RenderTarget::colorBufferFormat(usesHDR);
+            receiveDesc.renderTargetCount = 1;
+            receiveDesc.depthTargetFormat = RenderTarget::depthBufferFormat();
+            receiveDesc.depthEnabled = false;
+            receiveDesc.depthWriteEnabled = false;
+            receiveDesc.multisampling = multisampling;
+            receiveDesc.cullMode = RenderCullMode::NONE;
+            receiveDesc.primitiveTopology = RenderPrimitiveTopology::TRIANGLE_LIST;
+            receiveDesc.inputSlots = receiveSlots;
+            receiveDesc.inputSlotsCount = 2;
+            receiveDesc.inputElements = receiveElements;
+            receiveDesc.inputElementsCount = 2;
+            receiveDesc.vertexShader = receiveVS.get();
+            receiveDesc.pixelShader = receivePS.get();
+            shadowReceive.pipeline = device->createGraphicsPipeline(receiveDesc);
+        }
 #   endif
     }
 };
