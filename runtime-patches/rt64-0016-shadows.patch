diff --git a/src/shaders/ShadowPS.hlsl b/src/shaders/ShadowPS.hlsl
new file mode 100644
index 0000000..c8cc9d6
--- /dev/null
+++ b/src/shaders/ShadowPS.hlsl
@@ -0,0 +1,87 @@
+//
+// RT64
+//
+// Rush 2049 patch: sun shadows. Each vertex's position as the sun sees it (an orthographic projection of RT64's world
+// position, made on the CPU in FramebufferRenderer::addFramebuffer) is a second vertex buffer beside the screen
+// positions. Where a scene's 3D ends and its HUD begins:
+//   SHADOW_DEPTH_VS/PS    the scene's draws that write depth drawn again from the sun into the shadow map (depth only).
+//   SHADOW_RECEIVE_VS/PS  the same draws drawn again over the scene, at their own screen positions with an equal depth
+//                         test, so only the pixels they left in view count; each multiplies the colour there by the
+//                         shadow tint where the shadow map says something nearer the sun covers it.
+//
+
+#include "shared/rt64_shadow.h"
+
+[[vk::push_constant]] ConstantBuffer<ShadowCB> gConstants : register(b0);
+
+#if defined(SHADOW_DEPTH_VS)
+void VSMain(in float4 iSunPos : POSITION, out float4 oPosition : SV_POSITION) {
+    oPosition = iSunPos;
+}
+#elif defined(SHADOW_DEPTH_PS)
+void PSMain() { }
+#elif defined(SHADOW_RECEIVE_VS)
+void VSMain(in float4 iPosition : POSITION, in float4 iSunPos : TEXCOORD, out float4 oPosition : SV_POSITION, out float3 oSunPos : TEXCOORD0) {
+    // As RasterVS does it, so the depth comes out the same and the equal depth test passes.
+    float4 ndcPos = iPosition;
+    ndcPos.xy -= float2(gConstants.resolution / 2);
+    ndcPos.xy /= float2(gConstants.resolution.x / 2.0f, gConstants.resolution.y / -2.0f);
+    ndcPos.xyz *= ndcPos.w;
+    ndcPos.xy = (ndcPos.xy * gConstants.screenScale) + gConstants.screenOffset * ndcPos.w;
+    oPosition = ndcPos;
+    oSunPos = iSunPos.xyz;
+}
+#elif defined(SHADOW_RECEIVE_PS)
+Texture2D<float> gShadowMap : register(t1);
+// The scene's depth: only the pixels a draw left in view take its shadow (its depth there is its own, within a
+// little: this pass makes the depth as RasterVS does, but not to the last bit).
+#if defined(MULTISAMPLING)
+Texture2DMS<float> gSceneDepth : register(t2);
+float sceneDepth(int2 p) { return gSceneDepth.Load(p, 0); }
+#else
+Texture2D<float> gSceneDepth : register(t2);
+float sceneDepth(int2 p) { return gSceneDepth.Load(int3(p, 0)); }
+#endif
+
+float4 PSMain(in float4 iPosition : SV_POSITION, in float3 iSunPos : TEXCOORD0) : SV_TARGET {
+    if (abs(sceneDepth(int2(iPosition.xy)) - iPosition.z) > 4e-6f) {
+        discard;
+    }
+
+    const float2 uv = float2(iSunPos.x * 0.5f + 0.5f, 0.5f - iSunPos.y * 0.5f);
+    uint width, height;
+    gShadowMap.GetDimensions(width, height);
+
+    // A steeper surface from the sun takes more bias.
+    const float slope = max(abs(ddx(iSunPos.z)), abs(ddy(iSunPos.z)));
+    const float depth = iSunPos.z - gConstants.bias - slope * 1.5f;
+
+    // 4x4 taps with bilinear weights at the edges: a soft edge about two texels wide.
+    const float2 texel = uv * float2(width, height) - 0.5f;
+    const int2 base = int2(floor(texel));
+    const float2 f = texel - floor(texel);
+    const float wx[4] = { 1.0f - f.x, 1.0f, 1.0f, f.x };
+    const float wy[4] = { 1.0f - f.y, 1.0f, 1.0f, f.y };
+    float shadow = 0.0f;
+    [unroll] for (int y = 0; y < 4; y++) {
+        [unroll] for (int x = 0; x < 4; x++) {
+            const int2 p = clamp(base + int2(x - 1, y - 1), int2(0, 0), int2(width - 1, height - 1));
+            const float occluder = gShadowMap.Load(int3(p, 0));
+            shadow += (occluder < depth) ? (wx[x] * wy[y]) : 0.0f;
+        }
+    }
+
+    shadow /= 9.0f;
+
+    // Fades out towards the edges of the map and its far end, so there's no line where it stops.
+    const float edge = max(abs(iSunPos.x), abs(iSunPos.y));
+    shadow *= saturate((1.0f - edge) * 8.0f) * saturate((1.0f - iSunPos.z) * 8.0f);
+    if (gConstants.debugView > 0.5f) {
+        if ((edge > 1.0f) || (iSunPos.z < 0.0f) || (iSunPos.z > 1.0f)) return float4(0.3f, 0.3f, 1.0f, 1.0f);
+        return lerp(float4(0.3f, 1.0f, 0.3f, 1.0f), float4(1.0f, 0.2f, 0.2f, 1.0f), shadow);
+    }
+
+    const float3 factor = lerp(float3(1.0f, 1.0f, 1.0f), gConstants.tint, shadow * gConstants.strength);
+    return float4(factor, 1.0f);
+}
+#endif
diff --git a/src/shared/rt64_shadow.h b/src/shared/rt64_shadow.h
new file mode 100644
index 0000000..39a4060
--- /dev/null
+++ b/src/shared/rt64_shadow.h
@@ -0,0 +1,25 @@
+//
+// RT64
+//
+// Rush 2049 patch: the shadow passes' parameters (ShadowPS.hlsl, FramebufferRenderer::submitRasterScene).
+//
+
+#pragma once
+
+#include "shared/rt64_hlsl.h"
+
+#ifdef HLSL_CPU
+namespace interop {
+#endif
+    struct ShadowCB {
+        float2 resolution;   // receive: the framebuffer's size in N64 pixels (FramebufferParams.resolution)
+        float2 screenScale;  // receive: the draw's screen scale and offset, as RasterVS takes them
+        float2 screenOffset;
+        float strength;      // receive: 0 none, 1 the full shadow colour
+        float bias;          // receive: subtracted from the receiver's depth from the sun, in the map's depth units
+        float3 tint;         // receive: what a pixel fully in shadow is multiplied by
+        float debugView;     // receive: 1 for the debug colours (RT64::ShadowSettings::debugView)
+    };
+#ifdef HLSL_CPU
+};
+#endif
